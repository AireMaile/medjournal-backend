// MedJournal - Prisma Schema
// Database: Supabase (PostgreSQL)
// Auth: Supabase Auth (users managed externally, referenced by UUID)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// PROFILE
// Supabase Auth manages authentication and owns
// the email/password. This table stores only
// app-specific preferences, linked to the
// Supabase auth.users UUID.
//
// Rows are created automatically via a Supabase
// database trigger when a user signs up —
// no POST /users endpoint needed.
// ─────────────────────────────────────────────
model Profile {
  id                   String           @id
  name                 String           @default("")
  notificationTime     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  userMedications      UserMedication[]
  moodLogs             MoodLog[]

  @@map("profiles")
}

// ─────────────────────────────────────────────
// USER MEDICATIONS
// A user's personal prescription history.
// Free-text customName — no master list.
// When a medication changes, the current record
// is ended (endDate set) and a new one is created.
// This preserves full history for trend analysis.
// ─────────────────────────────────────────────
model UserMedication {
  id             String      @id @default(uuid())
  userId         String
  customName     String?
  dosage         String
  startDate      DateTime
  endDate        DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  profile        Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodLogs       MoodLog[]

  @@map("user_medications")
}

// ─────────────────────────────────────────────
// MOOD LOGS
// One log per day per user.
// ─────────────────────────────────────────────
model MoodLog {
  id                 String          @id @default(uuid())
  userId             String
  userMedicationId   String?
  logDate            DateTime
  logType            String          // QUICK | DETAILED
  moodScore          Int             // 1–5
  energyScore        Int             // 1–5
  quickNote          String?
  anhedonia          Int?              // 1–5, QUICK: loss of interest/pleasure
  sleepQuality       Int?
  sleepHours         Float?
  anxietyScore       Int?
  appetiteScore      Int?
  socialMotivation   Int?
  concentrationScore Int?              // 1–5, DETAILED
  functionalImpairment Int?            // 1–5, DETAILED: higher = worse
  medicationAdherence Boolean?         // did they take their meds today
  overallScore       Float?            // computed at write time, powers calendar
  detailedNote       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  profile            Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMedication     UserMedication? @relation(fields: [userMedicationId], references: [id])

  @@unique([userId, logDate])
  @@map("mood_logs")
}
