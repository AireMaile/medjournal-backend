// MedJournal - Prisma Schema
// Database: Supabase (PostgreSQL)
// Auth: Supabase Auth (users managed externally, referenced by UUID)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// PROFILE
// Supabase Auth manages authentication and owns
// the email/password. This table stores only
// app-specific preferences, linked to the
// Supabase auth.users UUID.
//
// Rows are created automatically via a Supabase
// database trigger when a user signs up —
// no POST /users endpoint needed.
// ─────────────────────────────────────────────
model Profile {
  id                   String           @id
  name                 String           @default("")
  notificationTime     String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  userMedications      UserMedication[]
  moodLogs             MoodLog[]
  medicationLogs       MedicationLog[]

  @@map("profiles")
}

// ─────────────────────────────────────────────
// USER MEDICATIONS
// A user's personal prescription history.
// Free-text customName — no master list.
// When a medication changes, the current record
// is ended (endDate set) and a new one is created.
// This preserves full history for trend analysis.
// ─────────────────────────────────────────────
model UserMedication {
  id              String          @id @default(uuid())
  userId          String
  customName      String?
  dosage          String
  startDate       DateTime
  endDate         DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  profile         Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationLogs  MedicationLog[]

  @@map("user_medications")
}

// ─────────────────────────────────────────────
// MOOD LOGS
// One log per day per user.
// All scored fields are optional — users are not
// required to answer every question on a given day.
// ─────────────────────────────────────────────
model MoodLog {
  id                   String    @id @default(uuid())
  userId               String
  logDate              DateTime
  logType              String?   // QUICK | DETAILED
  moodScore            Int?      // 1–5
  energyScore          Int?      // 1–5
  quickNote            String?
  anhedonia            Int?      // 1–5, loss of interest/pleasure
  sleepQuality         Int?      // 1–5
  sleepHours           Float?
  anxietyScore         Int?      // 1–5
  appetiteScore        Int?      // 1–5
  socialMotivation     Int?      // 1–5
  concentrationScore   Int?      // 1–5
  functionalImpairment Int?      // 1–5, higher = worse
  overallScore         Float?    // computed at write time, powers calendar
  detailedNote         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile              Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logDate])
  @@map("mood_logs")
}

// ─────────────────────────────────────────────
// MEDICATION LOGS
// Tracks each medication intake event separately
// from mood logs. Multiple entries per day are
// supported (e.g. Adderall AM + PM).
// Decoupled from MoodLog — joined by userId + logDate.
// ─────────────────────────────────────────────
model MedicationLog {
  id                String         @id @default(uuid())
  userId            String
  userMedicationId  String
  logDate           DateTime
  timeOfDay         String         // MORNING | AFTERNOON | EVENING
  taken             Boolean        @default(false)
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  profile           Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMedication    UserMedication @relation(fields: [userMedicationId], references: [id], onDelete: Cascade)

  @@map("medication_logs")
}
