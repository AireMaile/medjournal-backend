// MedJournal - Prisma Schema
// Database: Supabase (PostgreSQL)
// Auth: Supabase Auth (users managed externally, referenced by UUID)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// Supabase Auth manages authentication.
// This table stores app-specific user preferences,
// linked to the Supabase auth.users UUID.
// ─────────────────────────────────────────────
model User {
  id                   String           @id @default(uuid()) // mirrors Supabase auth UID
  name                 String
  email                String           @unique
  notificationTime     String?          // e.g. "08:00" — time of daily reminder
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  userMedications      UserMedication[]
  moodLogs             MoodLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// USER MEDICATIONS
// A user's personal prescription history.
// Medication name is free-text — no master list.
// When a medication is switched, the current record
// is ended (endDate set) and a new one is created.
// This preserves full history and allows the trend
// chart to mark change events.
// ─────────────────────────────────────────────
model UserMedication {
  id             String      @id @default(uuid())
  userId         String
  name           String      // free-text medication name entered by user
  startDate      DateTime
  endDate        DateTime?   // null = currently active
  notes          String?     // e.g. "switched due to nausea"
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodLogs       MoodLog[]

  @@map("user_medications")
}

// ─────────────────────────────────────────────
// MOOD LOGS
// One log per day per user. The userMedicationId
// captures which prescription was active at the
// time of logging — critical for trend analysis.
// Dosage is captured per-log so it can vary
// day-to-day (e.g. during titration).
// ─────────────────────────────────────────────
model MoodLog {
  id                 String          @id @default(uuid())
  userId             String
  userMedicationId   String          // active prescription at time of log
  logDate            DateTime        // date only — one per day
  dosage             String          // e.g. "50mg" — captured at log time
  moodScore          Int             // 1–5
  energyScore        Int             // 1–5
  note               String?         // optional free-text note

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMedication     UserMedication  @relation(fields: [userMedicationId], references: [id])

  @@unique([userId, logDate]) // enforce one log per user per day
  @@map("mood_logs")
}
